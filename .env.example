SPOTIFY_CLIENT_ID=seu_client_id
SPOTIFY_CLIENT_SECRET=seu_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/spotify/callback
ADMIN_PASSWORD=uma_senha_qualquer

# Onde o app discogs_shelf está servindo a coleção (aba Discogs).
DISCOGS_SHELF_URL=http://127.0.0.1:3001

# Mercado (ISO 3166-1 alpha-2) usado para decidir o que é tocável na aba
# Discogs. Opcional; sem ele o Spotify não informa disponibilidade.
SPOTIFY_MARKET=BR

# Chave da YouTube Data API v3 (console.cloud.google.com), usada para achar o
# clipe oficial de cada faixa no feed. Opcional; sem ela o link simplesmente
# não aparece. Quota padrão é 10.000 unidades/dia, e cada busca custa 100.
YOUTUBE_API_KEY=

