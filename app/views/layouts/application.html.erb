<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "DekSlayer's Latest Activity" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#050609">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Spotify's embed controller — lets one persistent player switch tracks.
        The callback is registered before the async script so the ready event
        can never fire into an empty handler. %>
    <%= javascript_tag nonce: true do %>
      window.spotifyIframeApi = null;
      window.onSpotifyIframeApiReady = function (api) {
        window.spotifyIframeApi = api;
        window.dispatchEvent(new Event("spotify-iframe-api-ready"));
      };
    <% end %>
    <%# The nonce matters: this tag is a loader that injects the real API from
        Spotify's CDN, copying its own nonce onto that script. Without one here
        there is nothing to copy, and the injected script has to survive on the
        host allowlist alone. %>
    <%= javascript_include_tag "https://open.spotify.com/embed/iframe-api/v1",
                               async: true, nonce: true %>

    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_javascript_tag 'application.jsx' %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
